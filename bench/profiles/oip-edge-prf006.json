{
 "name": "oip-edge-prf006",
 "description": "PRF-006 on EDGE (4 vCPU / 4 GB): starts at the 88,500-tag floor, then the oip-edge steps. 100% changing every 1000 ms, local history on (one HistorySettings per tag, embedded historian). Cutoffs, windows and sampling copied unchanged from oip-edge.",
 "points": [
  88500,
  120000,
  160000,
  200000
 ],
 "periodMs": 1000,
 "percentChanging": 100,
 "protocols": [
  "modbus"
 ],
 "warmupSeconds": 15,
 "sampleSeconds": 45,
 "sampleIntervalSeconds": 1,
 "sampleTags": 32,
 "registersPerUnit": 10000,
 "metricsPerDevice": 500,
 "modbusExtraPorts": 0,
 "tagBatch": 2000,
 "maxWallSeconds": 7200,
 "cutoffs": {
  "cpuPercent": 50,
  "memoryPercent": 50,
  "driftPercent": 10,
  "qualityErrorFraction": 0.01,
  "minReads": 8
 },
 "oip": {
  "opcuaReadEndpoint": "opc.tcp://127.0.0.1:4840/oip",
  "opcuaNodeId": "ns=2;s=Tags/{provider}/{path}",
  "readViaOpcUa": true,
  "history": {
   "storageProvider": "local",
   "sampleMode": "onChange"
  }
 }
}
