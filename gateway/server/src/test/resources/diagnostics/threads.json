{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["threads"],
  "additionalProperties": false,
  "properties": {
    "threads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "state", "daemon", "cpuNanos", "blockedCount", "waitedCount"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "integer"},
          "name": {"type": "string", "minLength": 1},
          "state": {"type": "string", "enum": ["NEW", "RUNNABLE", "BLOCKED", "WAITING", "TIMED_WAITING", "TERMINATED"]},
          "daemon": {"type": "boolean"},
          "cpuNanos": {"type": "integer"},
          "blockedCount": {"type": "integer", "minimum": 0},
          "waitedCount": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
