{
  "name": "dev",
  "description": "Default ramp for an 8 vCPU box with about 3 GB free. One gateway at a time. Modbus only, up to 10k points.",
  "points": [1000, 5000, 10000],
  "periodMs": 1000,
  "percentChanging": 10,
  "protocols": ["modbus"],
  "warmupSeconds": 5,
  "sampleSeconds": 15,
  "sampleIntervalSeconds": 1,
  "sampleTags": 16,
  "registersPerUnit": 10000,
  "metricsPerDevice": 500,
  "modbusExtraPorts": 1,
  "maxWallSeconds": 900,
  "requireDevices": true,
  "cutoffs": {"cpuPercent": 50, "memoryPercent": 50, "driftPercent": 10, "qualityErrorFraction": 0.01, "minReads": 4}
}
